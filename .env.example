# Local Payload secret belongs in .dev.vars (copy .dev.vars.example).
# Production: openssl rand -base64 48, then `pnpm wrangler secret put PAYLOAD_SECRET`.
PAYLOAD_SECRET=

# Owner account email. Local placeholder lives in .dev.vars.example.
# Production: `pnpm wrangler secret put OWNER_EMAIL`. Never commit a real address.
OWNER_EMAIL=
