# Local development only. Copy to .dev.vars (gitignored).
# Production rejects this placeholder. Set a new secret with:
#   openssl rand -base64 48
#   pnpm wrangler secret put PAYLOAD_SECRET
PAYLOAD_SECRET=local-dev-only-placeholder

# Signup with this email becomes the owner. Every other self-signup is a viewer.
# Production: pnpm wrangler secret put OWNER_EMAIL
# Placeholder only. Never commit a real address.
OWNER_EMAIL=owner@example.com
